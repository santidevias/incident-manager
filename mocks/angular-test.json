          "uuid": "f3e43ad9-d8a1-4eb5-ba0b-ec765b7f5c7d",
          "body": "{\n  \"success\": true,\n  \"message\": \"Incidencias recuperadas exitosamente\",\n  \"data\": [\n    {\n      \"id\": \"inc-001\",\n      \"title\": \"Fallo en servidor de base de datos principal\",\n      \"description\": \"El clúster primario de PostgreSQL está rechazando conexiones por límite de sockets.\",\n      \"category\": \"Infraestructura\",\n      \"priority\": \"CRITICAL\",\n      \"status\": \"OPEN\",\n      \"reportId\": \"usr-101\",\n      \"assignedAggentId\": \"agt-201\",\n      \"createdAt\": \"2026-09-10T08:30:00Z\",\n      \"updatedAt\": \"2026-09-10T08:30:00Z\"\n    },\n    {\n      \"id\": \"inc-002\",\n      \"title\": \"Error 500 al procesar pagos con tarjeta\",\n      \"description\": \"La pasarela de pagos retorna tiempo de espera agotado al confirmar la transacción.\",\n      \"category\": \"Pagos\",\n      \"priority\": \"HIGH\",\n      \"status\": \"IN_PROGRESS\",\n      \"reportId\": \"usr-102\",\n      \"assignedAggentId\": \"agt-202\",\n      \"createdAt\": \"2026-09-11T09:15:00Z\",\n      \"updatedAt\": \"2026-09-11T10:00:00Z\"\n    },\n    {\n      \"id\": \"inc-003\",\n      \"title\": \"Incapacidad para descargar facturas en PDF\",\n      \"description\": \"Los clientes reportan un botón deshabilitado en la sección de historial de compras.\",\n      \"category\": \"Facturación\",\n      \"priority\": \"MEDIUM\",\n      \"status\": \"OPEN\",\n      \"reportId\": \"usr-103\",\n      \"assignedAggentId\": \"agt-201\",\n      \"createdAt\": \"2026-09-12T11:45:00Z\",\n      \"updatedAt\": \"2026-09-12T11:45:00Z\"\n    },\n    {\n      \"id\": \"inc-004\",\n      \"title\": \"Error tipográfico en el menú de navegación\",\n      \"description\": \"El texto de la pestaña 'Contáctanos' dice 'Contátenos'.\",\n      \"category\": \"UI/UX\",\n      \"priority\": \"LOW\",\n      \"status\": \"CLOSED\",\n      \"reportId\": \"usr-104\",\n      \"assignedAggentId\": \"agt-203\",\n      \"createdAt\": \"2026-09-13T14:20:00Z\",\n      \"updatedAt\": \"2026-09-14T09:00:00Z\"\n    },\n    {\n      \"id\": \"inc-005\",\n      \"title\": \"Vulnerabilidad detectada en dependencia de npm\",\n      \"description\": \"Alerta de seguridad automatizada sobre paquete con riesgo de inyección de código.\",\n      \"category\": \"Seguridad\",\n      \"priority\": \"CRITICAL\",\n      \"status\": \"IN_PROGRESS\",\n      \"reportId\": \"usr-105\",\n      \"assignedAggentId\": \"agt-202\",\n      \"createdAt\": \"2026-09-13T16:00:00Z\",\n      \"updatedAt\": \"2026-09-14T08:15:00Z\"\n    },\n    {\n      \"id\": \"inc-006\",\n      \"title\": \"Lentitud extrema en el reporte mensual\",\n      \"description\": \"La consulta de métricas tarda más de 45 segundos en renderizarse.\",\n      \"category\": \"Rendimiento\",\n      \"priority\": \"MEDIUM\",\n      \"status\": \"OPEN\",\n      \"reportId\": \"usr-106\",\n      \"assignedAggentId\": \"agt-204\",\n      \"createdAt\": \"2026-09-14T10:10:00Z\",\n      \"updatedAt\": \"2026-09-14T10:10:00Z\"\n    },\n    {\n      \"id\": \"inc-007\",\n      \"title\": \"Correos de confirmación no se están enviando\",\n      \"description\": \"El servicio de SendGrid bloqueó la clave de API por superar la cuota temporal.\",\n      \"category\": \"Notificaciones\",\n      \"priority\": \"HIGH\",\n      \"status\": \"CLOSED\",\n      \"reportId\": \"usr-107\",\n      \"assignedAggentId\": \"agt-203\",\n      \"createdAt\": \"2026-09-14T12:00:00Z\",\n      \"updatedAt\": \"2026-09-15T15:30:00Z\"\n    },\n    {\n      \"id\": \"inc-008\",\n      \"title\": \"Sesión expirada prematuramente en la App Móvil\",\n      \"description\": \"Los usuarios deben iniciar sesión cada 5 minutos debido a una mala expiración del JWT.\",\n      \"category\": \"Autenticación\",\n      \"priority\": \"HIGH\",\n      \"status\": \"IN_PROGRESS\",\n      \"reportId\": \"usr-108\",\n      \"assignedAggentId\": \"agt-201\",\n      \"createdAt\": \"2026-09-15T07:50:00Z\",\n      \"updatedAt\": \"2026-09-15T11:20:00Z\"\n    },\n    {\n      \"id\": \"inc-009\",\n      \"title\": \"El modo oscuro rompe el contraste en tablas\",\n      \"description\": \"Al activar el tema oscuro, las letras en las tablas permanecen de color negro.\",\n      \"category\": \"UI/UX\",\n      \"priority\": \"LOW\",\n      \"status\": \"OPEN\",\n      \"reportId\": \"usr-109\",\n      \"assignedAggentId\": \"agt-204\",\n      \"createdAt\": \"2026-09-15T13:40:00Z\",\n      \"updatedAt\": \"2026-09-15T13:40:00Z\"\n    },\n    {\n      \"id\": \"inc-010\",\n      \"title\": \"Fallo de sincronización con almacenamiento S3\",\n      \"description\": \"Los archivos adjuntos de las incidencias no se están subiendo al bucket remoto.\",\n      \"category\": \"Almacenamiento\",\n      \"priority\": \"MEDIUM\",\n      \"status\": \"OPEN\",\n      \"reportId\": \"usr-110\",\n      \"assignedAggentId\": \"agt-202\",\n      \"createdAt\": \"2026-09-15T18:00:00Z\",\n      \"updatedAt\": \"2026-09-15T18:00:00Z\"\n    }\n  ],\n  \"meta\": {\n    \"page\": 1,\n    \"pageSize\": 10,\n    \"totalItems\": 45,\n    \"totalPages\": 5\n  }\n}",
